# Fixed operator-controlled Dolibarr instance. HTTPS is required in production.
DOLIBARR_BASE_URL=https://erp.example.invalid/dolibarr
# DOLIBARR_CA_BUNDLE=/run/secrets/private-ca.pem

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Use exact public values in production. Port wildcards are allowed only for loopback development.
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,[::1],[::1]:*
MCP_ALLOWED_ORIGINS=

DOLIBARR_CONNECT_TIMEOUT=5
DOLIBARR_READ_TIMEOUT=10
DOLIBARR_WRITE_TIMEOUT=10
DOLIBARR_POOL_TIMEOUT=5
DOLIBARR_MAX_CONNECTIONS=100
DOLIBARR_MAX_KEEPALIVE_CONNECTIONS=20
ALLOW_INSECURE_LOCALHOST=false

# Do not add DOLIBARR_API_KEY here. Every MCP client supplies its own key in:
# Authorization: Bearer <DOLIBARR_API_KEY>
