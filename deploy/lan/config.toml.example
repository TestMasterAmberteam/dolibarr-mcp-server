# Operator-requested HTTP listener with a direct HTTPS Dolibarr upstream.
dolibarr_base_url = "https://erp.amberteam.pl/dolibarr"
dolibarr_ca_bundle = "/etc/dolibarr-mcp/ca-bundle.pem"
allow_insecure_localhost = false
host = "0.0.0.0"
port = 8080
log_level = "INFO"
mcp_allowed_hosts = [
  # Replace the documentation address with the deployment host's LAN address.
  "192.0.2.10:8080",
  "mcp-dolibarr:8080",
  "127.0.0.1:8080",
  "localhost:8080",
]
mcp_allowed_origins = []
